      "path": "contents/components/tabs/7/index.tsx",
      "content": "import { BoxIcon, HouseIcon, PanelsTopLeftIcon } from \"lucide-react\";\n\nimport { ScrollArea, ScrollBar } from \"@/components/ui/scroll-area\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\n\nexport default function Component() {\n  return (\n    <Tabs defaultValue=\"tab-1\">\n      <ScrollArea>\n        <TabsList className=\"mb-1 bg-transparent\">\n          <TabsTrigger\n            className=\"data-[state=active]:bg-primary data-[state=active]:text-primary-foreground rounded-full data-[state=active]:shadow-none\"\n            value=\"tab-1\"\n          >\n            <HouseIcon\n              aria-hidden=\"true\"\n              className=\"-ms-0.5 me-1.5 opacity-60\"\n              size={16}\n            />\n            Overview\n          </TabsTrigger>\n          <TabsTrigger\n            className=\"data-[state=active]:bg-primary data-[state=active]:text-primary-foreground rounded-full data-[state=active]:shadow-none\"\n            value=\"tab-2\"\n          >\n            <PanelsTopLeftIcon\n              aria-hidden=\"true\"\n              className=\"-ms-0.5 me-1.5 opacity-60\"\n              size={16}\n            />\n            Projects\n          </TabsTrigger>\n          <TabsTrigger\n            className=\"data-[state=active]:bg-primary data-[state=active]:text-primary-foreground rounded-full data-[state=active]:shadow-none\"\n            value=\"tab-3\"\n          >\n            <BoxIcon\n              aria-hidden=\"true\"\n              className=\"-ms-0.5 me-1.5 opacity-60\"\n              size={16}\n            />\n            Packages\n          </TabsTrigger>\n        </TabsList>\n        <ScrollBar orientation=\"horizontal\" />\n      </ScrollArea>\n      <div className=\"bg-muted rounded-lg p-4\">\n        <TabsContent value=\"tab-1\">\n          <p className=\"text-xs\">Content for Tab 1</p>\n        </TabsContent>\n        <TabsContent value=\"tab-2\">\n          <p className=\"text-xs\">Content for Tab 2</p>\n        </TabsContent>\n        <TabsContent value=\"tab-3\">\n          <p className=\"text-xs\">Content for Tab 3</p>\n        </TabsContent>\n      </div>\n    </Tabs>\n  );\n}\n",
      "type": "registry:component",
      "target": "components/tabs7.tsx"
    }
  ],
